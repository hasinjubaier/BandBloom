# =============================================================================
# BandBloom Environment Configuration (.env.example)
# Aligned with BandBloom Technical Blueprint v2 (Section 12.4)
# =============================================================================

# Application Environment
APP_ENV=development
APP_NAME=BandBloom
PORT=8000
DEBUG=True

# Database (PostgreSQL + pgvector)
# For local development with docker:
DATABASE_URL=postgresql+asyncpg://bandbloom_user:bandbloom_password@localhost:5432/bandbloom_db
SYNC_DATABASE_URL=postgresql://bandbloom_user:bandbloom_password@localhost:5432/bandbloom_db

# Redis & Background Workers
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3-compatible) for audio & file assets
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=bandbloom-private-media
SIGNED_URL_TTL_SECONDS=300

# AI Provider Credentials (Never expose in browser or commit to git!)
LLM_API_KEY=your_openai_or_compatible_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# RAG & Tutor Governance
RAG_TOP_K=8
RAG_MIN_RELEVANCE=0.72
MAX_TUTOR_REQUEST_CHARS=4000
TUTOR_PER_USER_DAILY_QUOTA=25
